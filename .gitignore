# ── Android TWA (generated by Bubblewrap) ──
apps/android-twa/app/
apps/android-twa/*.keystore

# Re-include product assets that the global media rules above would ignore.
# (Fixtures must stay synthetic — NEVER commit real chats.)
!apps/web/public/**
!apps/ios/**/*.xcassets/**
!packages/design-tokens/tokens/**
!packages/design-tokens/scripts/**
!packages/design-tokens/package.json
!packages/design-tokens/tsconfig.json
!packages/design-tokens/README.md
!fixtures/**
