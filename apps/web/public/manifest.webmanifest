{
  "name": "WhatsAppya",
  "short_name": "WhatsAppya",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
