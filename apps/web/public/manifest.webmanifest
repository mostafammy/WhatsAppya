{
  "name": "WhatsAppya",
  "short_name": "WhatsAppya",
  "description": "Private, on-device WhatsApp chat export viewer and archive reader.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#EFEAE2",
  "theme_color": "#007AFF",
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "export", "accept": ["application/zip", ".zip", "text/plain", ".txt"] }]
    }
  }
}
