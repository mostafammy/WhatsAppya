{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      "**/dist/**",
      "**/node_modules/**",
      "legacy/**",
      "converter/**",
      "assets/**",
      "apps/web/public/vendor/**",
      "*.min.js",
      "script.js",
      "style.css",
      "WhatsAppChat/**",
      "apps/ios/**",
      "apps/android-twa/**",
      ".turbo/**",
      ".idea/**",
      "tests/**"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "organizeImports": {
    "enabled": true
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
