{
  "name": "whatsappya",
  "private": true,
  "version": "0.0.0",
  "description": "Private, on-device WhatsApp chat export viewer — monorepo root",
  "packageManager": "pnpm@12.5.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@whatsappya/web",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "tokens": "pnpm --filter @whatsappya/design-tokens build",
    "ci": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
